generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RaffleStatus {
  DRAFT
  OPEN
  CLOSED
  READY
  DRAWING
  COMPLETED
  CANCELLED
}

enum RaffleEntrySource {
  YAPE
  YOUTUBE_MEMBER
  MANUAL
  COURTESY
  IMPORT
}

enum RaffleEntryStatus {
  PENDING
  VALIDATED
  REJECTED
  CANCELLED
}

enum DrawSessionStatus {
  READY
  DRAWING
  COMPLETED
}

enum AuditEventType {
  RAFFLE_CLOSED
  DRAW_STARTED
  DRAW_COMPLETED
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  brands       Brand[]
  users        User[]
  raffles      Raffle[]
  participants Participant[]
  entries      RaffleEntry[]
  drawSessions DrawSession[]
  drawResults  DrawResult[]
  auditEvents  AuditEvent[]

  @@map("organizations")
}

model Brand {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  slug           String
  logoUrl        String?     @map("logo_url")
  themeConfig    Json?       @map("theme_config")
  status         BrandStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  raffles      Raffle[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(ADMIN)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  createdRaffles Raffle[]     @relation("RaffleCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Raffle {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  brandId            String?      @map("brand_id") @db.Uuid
  createdById        String?      @map("created_by_id") @db.Uuid
  name               String
  slug               String
  description        String?
  prizeName          String       @map("prize_name")
  prizeDescription   String?      @map("prize_description")
  prizeImageUrl      String?      @map("prize_image_url")
  status             RaffleStatus @default(DRAFT)
  startsAt           DateTime?    @map("starts_at")
  closesAt           DateTime?    @map("closes_at")
  nextTicketSequence Int          @default(0) @map("next_ticket_sequence")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  brand        Brand?        @relation(fields: [brandId], references: [id])
  createdBy    User?         @relation("RaffleCreatedBy", fields: [createdById], references: [id])
  entries      RaffleEntry[]
  drawSession  DrawSession?  @relation("RaffleDrawSession")
  drawResult   DrawResult?   @relation("RaffleDrawResult")
  auditEvents  AuditEvent[]  @relation("RaffleAuditEvents")

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([brandId])
  @@map("raffles")
}

model Participant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name")
  fullName       String?  @map("full_name")
  phone          String?
  email          String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  entries      RaffleEntry[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("participants")
}

model RaffleEntry {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  raffleId         String            @map("raffle_id") @db.Uuid
  participantId    String            @map("participant_id") @db.Uuid
  ticketNumber     String            @map("ticket_number")
  source           RaffleEntrySource
  paymentReference String?           @map("payment_reference")
  paymentAmount    Decimal?          @map("payment_amount") @db.Decimal(12, 2)
  status           RaffleEntryStatus @default(PENDING)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  raffle       Raffle       @relation(fields: [raffleId], references: [id])
  participant  Participant  @relation(fields: [participantId], references: [id])
  drawResults  DrawResult[] @relation("EntryWinner")

  @@unique([raffleId, ticketNumber])
  @@index([organizationId, raffleId])
  @@index([organizationId, participantId])
  @@index([raffleId, status])
  @@map("raffle_entries")
}

model DrawSession {
  id                      String            @id @default(uuid()) @db.Uuid
  organizationId          String            @map("organization_id") @db.Uuid
  raffleId                String            @unique @map("raffle_id") @db.Uuid
  participantSnapshot     Json              @map("participant_snapshot")
  participantSnapshotHash String            @map("participant_snapshot_hash")
  seedCommitment          String            @map("seed_commitment")
  secretSeed              String            @map("secret_seed")
  algorithmVersion        String            @map("algorithm_version")
  status                  DrawSessionStatus @default(READY)
  startedAt               DateTime?         @map("started_at")
  completedAt             DateTime?         @map("completed_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  raffle       Raffle       @relation("RaffleDrawSession", fields: [raffleId], references: [id])
  result       DrawResult?

  @@unique([organizationId, raffleId])
  @@map("draw_sessions")
}

model DrawResult {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  drawSessionId  String   @map("draw_session_id") @db.Uuid
  raffleId       String   @map("raffle_id") @db.Uuid
  winnerEntryId  String   @map("winner_entry_id") @db.Uuid
  winnerIndex    Int      @map("winner_index")
  resultHash     String   @map("result_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  drawSession  DrawSession  @relation(fields: [drawSessionId], references: [id])
  raffle       Raffle       @relation("RaffleDrawResult", fields: [raffleId], references: [id])
  winnerEntry  RaffleEntry  @relation("EntryWinner", fields: [winnerEntryId], references: [id])

  @@unique([drawSessionId])
  @@unique([raffleId])
  @@index([organizationId, raffleId])
  @@map("draw_results")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  raffleId       String         @map("raffle_id") @db.Uuid
  type           AuditEventType
  payload        Json
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  raffle       Raffle       @relation("RaffleAuditEvents", fields: [raffleId], references: [id])

  @@index([organizationId, raffleId, createdAt])
  @@map("audit_events")
}
